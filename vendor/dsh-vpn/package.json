{
  "name": "@local/dsh-vpn",
  "version": "0.1.0",
  "private": true,
  "description": "一键连接深信服 aTrust VPN（vpn.seeyon.com）：自动唤起、自动登录、验证隧道是否真的通了。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "worker.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
